# One flag switches chat AND embeddings: gemini (dev, free tier) | openai (submission).
# Collections are seeded for both up front, so switching never reindexes.
PROVIDER=gemini

# Neon Postgres — source of truth. Qdrant is only an index over it.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Qdrant Cloud
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Provider keys (the PROVIDER flag picks which one chat+embeddings use;
# seeding uses both so both collections exist).
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Optional chat overrides; defaults derive from PROVIDER.
# GEMINI_MODEL=gemini-3.5-flash
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=

# Upstash Redis — per-IP rate limit + hard global daily budget cap.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DAILY_REQUEST_CAP=500

# Retrieval-score floor for abstention; default is per-provider (see
# src/config.ts). Override to hand-tune against real questions.
# ABSTENTION_THRESHOLD=
